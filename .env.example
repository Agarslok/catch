# Supabase: Settings → API → Project URL (público en el cliente)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Publishable (sb_publishable_...) o anon JWT (Settings → API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_key_here

# Obligatorio en servidor: cola del moderador, tokens de participante y lectura de preguntas (bypass RLS).
# Supabase → Settings → API → service_role (nunca en el cliente).
SUPABASE_SERVICE_ROLE_KEY=

# Token HMAC para publicar estado global (ruta /presenter)
MEETING_PRESENTER_SECRET=change-me-in-production

# Monitor IA (solo servidor) — POST /api/monitor/[meetingId]/chat
GEMINI_API_KEY=
# Opcional: modelo y timeout en ms (si no defines GEMINI_TIMEOUT_MS, el servidor usa el default del código)
# GEMINI_MODEL_ID=gemini-2.0-flash
# GEMINI_TIMEOUT_MS=<milliseconds>

# Desarrollo local: cada `npm run dev` reinicia paso 0 (poner 0 para conservar estado)
# MEETING_DEV_RESET_SESSION=0
# Reuniones a reiniciar en Supabase (coma-separado)
# MEETING_DEV_RESET_IDS=demo-q3-2026
