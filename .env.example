# Supabase: Settings → API → Project URL (público en el cliente)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Publishable (sb_publishable_...) o anon JWT (Settings → API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_key_here

# Obligatorio en servidor: cola del moderador, tokens de participante y lectura de preguntas (bypass RLS).
# Supabase → Settings → API → service_role (nunca en el cliente).
SUPABASE_SERVICE_ROLE_KEY=

# Solo local: contraseña de Postgres para `npm run db:push` (no subir al repo)
# SUPABASE_DB_PASSWORD=

# Token HMAC para publicar estado global (ruta /presenter)
MEETING_PRESENTER_SECRET=change-me-in-production

# Tavus CVI — solo servidor (POST /api/tavus/conversation). No expongas TAVUS_API_KEY al cliente.
# API key: Tavus Portal → Developers → API Keys
TAVUS_API_KEY=
# Face ID de Frida (en la API v2 es `face_id`; en el portal suele aparecer como Replica / Face)
TAVUS_REPLICA_ID=
# PAL ID de la persona Frida (en la API v2 es `pal_id`; en el portal: PAL / Persona)
TAVUS_PERSONA_ID=

# Avatar local MP4 (desactivado por defecto). Pon 1 para mostrar /avatar_video.mp4 además de Tavus.
# NEXT_PUBLIC_AVATAR_MP4_ENABLED=1
# NEXT_PUBLIC_AVATAR_VIDEO_SRC=/avatar_video.mp4

# Monitor IA (solo servidor) — POST /api/monitor/[meetingId]/chat (visitante)
# y POST /api/monitor/[meetingId]/interpret (moderador → contrato de acciones).
# Nunca expongas GEMINI_API_KEY al cliente ni en respuestas HTTP.
GEMINI_API_KEY=
# Opcional: modelo y timeout en ms (si no defines GEMINI_TIMEOUT_MS, el servidor usa el default del código)
# GEMINI_MODEL_ID=gemini-2.0-flash
# GEMINI_TIMEOUT_MS=<milliseconds>

# Desarrollo local: cada `npm run dev` reinicia paso 0 (poner 0 para conservar estado)
# MEETING_DEV_RESET_SESSION=0
# Reuniones a reiniciar en Supabase (coma-separado)
# MEETING_DEV_RESET_IDS=demo-q3-2026

# Netlify: define las variables anteriores en Site settings → Environment variables
# (scope Build y Functions). Tras el primer deploy, aplica en Supabase SQL Editor
# supabase/catch_production_catchup.sql si /api/supabase/health indica migraciones pendientes.
